{
  "private": true,
  "name": "squoosh",
  "version": "2.0.0",
  "type": "module",
  "license": "apache-2.0",
  "bin": {
    "squoosh": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "rollup -c && node lib/move-output.cjs",
    "build:cli": "tsc -p cli-tsconfig.json",
    "debug": "node --inspect-brk node_modules/.bin/rollup -c",
    "dev": "cross-env DEV_PORT=5000 run-p watch serve",
    "watch": "rollup -cw",
    "serve": "serve .tmp/build/static --listen 5000 -c ../../../serve.json",
    "cli": "node ./dist/cli/index.js",
    "lint": "eslint src/cli",
    "lint:fix": "eslint src/cli --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:perf": "cross-env RUN_PERF_TESTS=true vitest run src/cli/performance.test.ts",
    "typecheck": "tsc -p cli-tsconfig.json --noEmit",
    "generate:fixtures": "node src/test-fixtures/generate-fixtures.js",
    "prepare": "husky",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin",
    "tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@surma/rollup-plugin-off-main-thread": "^2.2.3",
    "@types/dedent": "^0.7.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@web/rollup-plugin-import-meta-assets": "^2.3.0",
    "chalk": "^5.0.0",
    "comlink": "^4.4.2",
    "commander": "^12.0.0",
    "cross-env": "^10.1.0",
    "cssnano": "^7.1.2",
    "dedent": "^0.7.0",
    "eslint": "^9.39.2",
    "file-drop-element": "^1.0.1",
    "glob": "^13.0.0",
    "happy-dom": "^20.3.4",
    "husky": "^9.1.7",
    "idb-keyval": "^6.2.2",
    "image-size": "^2.0.2",
    "inquirer": "^10.0.0",
    "linkstate": "^2.0.0",
    "lint-staged": "^16.2.7",
    "lodash.camelcase": "^4.3.0",
    "mime-types": "^2.1.35",
    "npm-run-all": "^4.1.5",
    "ora": "^8.0.0",
    "pointer-tracker": "^2.5.3",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "postcss-nested": "^7.0.2",
    "postcss-simple-vars": "^7.0.1",
    "postcss-url": "^10.1.3",
    "preact": "^10.28.2",
    "preact-render-to-string": "^6.6.5",
    "prettier": "^3.8.0",
    "rollup": "^4.55.2",
    "serve": "^14.2.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.17",
    "wasm-feature-detect": "^1.8.0"
  },
  "lint-staged": {
    "*.{js,css,json,md,ts,tsx}": "prettier --write",
    "*.{c,h,cpp,hpp}": "clang-format -i",
    "*.rs": "rustfmt"
  }
}
