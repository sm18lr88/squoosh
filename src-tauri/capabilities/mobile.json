{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "mobile",
  "description": "Mobile-specific capabilities",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:window:allow-set-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPDATA/**",
        "$PICTURE/**",
        "$DOCUMENT/**",
        "$DOWNLOAD/**"
      ]
    }
  ]
}
