{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squoosh",
  "version": "2.0.0",
  "identifier": "app.squoosh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../.tmp/build/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Squoosh",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Apache-2.0",
    "category": "Graphics",
    "shortDescription": "Image compression and optimization tool",
    "longDescription": "Squoosh is an image compression web app that reduces image sizes through powerful codecs. Now available as a native desktop application with GPU acceleration.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": null,
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": null,
      "wix": null,
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "iOS": {
      "developmentTeam": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "all": true,
      "scope": ["$APPDATA/**", "$HOME/**", "$DOWNLOAD/**", "$PICTURE/**", "$DOCUMENT/**"]
    },
    "dialog": {
      "all": true
    }
  }
}
